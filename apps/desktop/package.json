{
  "name": "suivievallab",
  "productName": "SuiviEvalLab",
  "version": "0.1.0",
  "description": "Poste de travail du suivi-évaluation, du cadre logique au rapport Word",
  "license": "GPL-3.0-or-later",
  "author": "SuiviEvalLab",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:ui": "vite build",
    "build": "npm run build:main && npm run build:ui",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "dev:ui": "vite",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
